{
  "name": "qq-farm-bot",
  "version": "2.7.1",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "client.js",
  "bin": "client.js",
  "scripts": {
    "start": "node client.js",
    "dev": "node client.js",
    "build:release": "pkg . --no-bytecode --targets node18-win-x64,node18-linux-x64,node18-macos-x64,node18-macos-arm64 --out-path dist",
    "build:win": "pkg . --no-bytecode --targets node18-win-x64 --out-path dist",
    "build:linux": "pkg . --no-bytecode --targets node18-linux-x64 --out-path dist",
    "build:mac": "pkg . --no-bytecode --targets node18-macos-x64,node18-macos-arm64 --out-path dist",
    "inspect:activity-har": "node scripts/inspect-activity-har.js",
    "inspect:protocol": "node scripts/inspect-protocol-capture.js",
    "inspect:cdn": "node scripts/find-cdn-resource.js",
    "extract:plant-phases": "node scripts/extract-plant-phase-images.js",
    "inspect:tsdk": "node scripts/inspect-tsdk-update.js",
    "capture:start": "node capture-server.js",
    "lint": "eslint . --fix",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.21.0",
    "long": "^5.3.2",
    "multer": "^2.2.0",
    "node-fetch": "^2.7.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.7",
    "protobufjs": "^8.0.0",
    "pushoo": "^0.1.11",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.4.3",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "../web/dist/**/*",
      "src/gameConfig/**/*",
      "src/proto/**/*",
      "src/utils/*.wasm",
      "src/__bolt_manifest.json",
      "share.txt"
    ]
  }
}
